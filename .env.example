# Copier en .env.local pour le développement. Ne jamais committer de vraie valeur.

# Fournisseur IA (cadrage Q3). Sans clé : mode démonstration explicite.
# Fournisseur IA : « openrouter » (recommandé, une clé pour tous les modèles de l'Atlas) ou « gemini » (Google direct).
LIMPID_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Routage de l'Atlas (identifiants OpenRouter ; défauts ci-dessous si vides).
LIMPID_MODEL_LITE=google/gemini-3.1-flash-lite
LIMPID_MODEL_EDITOR=google/gemini-3.8-flash
LIMPID_MODEL_COMPLEX=google/gemini-3.1-pro-preview
# Taux USD → euro pour le journal des coûts (coût réel renvoyé par OpenRouter et Recraft).
LIMPID_USD_TO_EUR=0.92
# Illustrations vectorielles (Recraft V4.1 Vector, SVG assainis) : 1 / 2 / 4 par rapport court / standard / long.
RECRAFT_API_KEY=
LIMPID_RECRAFT_MODEL=recraftv4_1_vector
# Gemini direct (seulement si LIMPID_AI_PROVIDER=gemini).
GEMINI_API_KEY=
# Essai réel du 4 octobre 2026 : gemini-3.5-flash valide le pipeline ; les modèles Pro sont à quota nul sur la clé actuelle (offre gratuite probable).
# Offre gratuite : 20 requêtes par jour ET par modèle (constaté le 4 octobre 2026). Un rapport coûte 2 à 6 requêtes,
# une lecture OCR 1 par lot de 8 pages, une correction de quiz 1. Deux modèles différents = deux quotas séparés.
LIMPID_MODEL_FAST=gemini-3.5-flash
LIMPID_MODEL_QUALITY=gemini-3.5-flash
# Rôles IA (V4), prioritaires sur les deux variables ci-dessus quand ils sont définis :
# AI_REPORT_MODEL : génération des rapports et des exercices ; AI_CHAT_MODEL : « Discuter », corrections.
# AI_REPORT_MODEL=gemini-3.8-flash
# AI_CHAT_MODEL=gemini-3.8-flash

# Supabase (cadrage Q2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Alpha privée : emails autorisés, séparés par des virgules (cadrage Q7)
LIMPID_ALLOWED_EMAILS=
# Administration : double authentification TOTP exigée (session aal2). « off » seulement en secours
# (application d'authentification perdue), le temps de reconfigurer le facteur.
# LIMPID_ADMIN_MFA=off

# Limites (payload 1, § 2)
LIMPID_MAX_FILE_MB=20
LIMPID_MAX_PAGES=100
# Texte retenu d'un fichier ou d'une page web ; au-delà, couverture partielle signalée.
LIMPID_MAX_SOURCE_CHARS=300000
LIMPID_MAX_IMAGE_MP=20
LIMPID_MAX_PASTED_CHARS=50000

# Vérification indépendante des affirmations contre leurs extraits (1 appel rapide par rapport).
LIMPID_VERIFY_CLAIMS=on
# Plan préalable (Flash-Lite) et rédaction Pro des documents complexes : off pour couper.
LIMPID_PLAN=on

# Modèles de repli (même fournisseur, séparés par des virgules, 3 au plus) quand le quota du jour
# du modèle principal est épuisé ou qu'il est surchargé (HTTP 503). Le modèle réellement utilisé est journalisé. Vide = aucun repli.
LIMPID_MODEL_FALLBACKS=

# Plafonds de rapports : fixés par offre dans src/lib/billing/catalog.ts (plus de variable).
# Texte extrait au plus (jetons), délai et redirections de l'import par lien.
LIMPID_MAX_EXTRACTED_TOKENS=120000
LIMPID_URL_TIMEOUT_MS=10000
LIMPID_URL_MAX_REDIRECTS=3
# Croquis générés dans les rapports : "off" pour les couper.
LIMPID_DRAWINGS=on

# Budget en centimes d'euro (cadrage Q17)
LIMPID_MONTHLY_CAP_CENTS=5000
LIMPID_REPORT_CAP_CENTS=120
LIMPID_ACCOUNT_DAILY_CAP_CENTS=600

# Conservation : originaux 24 h ; rapports effacés 30 jours après création (0 = jusqu'à suppression manuelle)
LIMPID_RETENTION_ORIGINAL_HOURS=24
LIMPID_RETENTION_REPORT_DAYS=30

# Phase 2b
# URL publique utilisée dans les liens magiques (sinon déduite de la requête).
LIMPID_SITE_URL=https://limpid.company
# Secret du cron Vercel qui reprend les tâches en attente (/api/worker).
CRON_SECRET=
# Tarifs d'estimation en centimes d'euro par million de jetons (à confirmer sur la grille Gemini).
LIMPID_PRICE_INPUT_CENTS_PER_MTOK=50
LIMPID_PRICE_OUTPUT_CENTS_PER_MTOK=400

# Quota gratuit Gemini affiché dans l'administration (requêtes par jour et par modèle).
LIMPID_FREE_TIER_RPD=20

# Lecture OCR des images et PDF scannés (vision Gemini), avec accord de l'utilisateur.
LIMPID_MAX_OCR_PAGES=30
LIMPID_MAX_OCR_MB=14

# Phase 3
# Import par lien (protection SSRF intégrée). « off » pour le désactiver.
LIMPID_URL_IMPORT=on

# Lot D — illustrations (cahier V2, § 9-10). Aucune dépendance payante n'est activée par défaut.
# Wikimedia Commons (gratuit, licences libres vérifiées fichier par fichier). « off » pour le couper.
LIMPID_ILLUSTRATIONS_COMMONS=on
# Unsplash : clé d'API requise ; images affichées sur le web seulement (jamais dans le PDF).
UNSPLASH_ACCESS_KEY=
LIMPID_ILLUSTRATIONS_UNSPLASH=off
# Gemini Image : modèle image séparé du modèle texte (ex. gemini-3.1-flash-lite-image), compte payant.
# Couverture : image Lite de Gemini (défaut avec OpenRouter : google/gemini-3.1-flash-lite-image).
LIMPID_IMAGE_MODEL=
LIMPID_ILLUSTRATIONS_GEMINI=off
LIMPID_GENERATED_IMAGES_PER_MONTH=20

# ---------------------------------------------------------------- Paiements Chariow (offres et recharges)
# Secrets à définir UNIQUEMENT dans Vercel (jamais dans le dépôt, jamais en NEXT_PUBLIC_).
# Clé API : Chariow → Paramètres → API (sk_live_…).
# CHARIOW_API_KEY=
# Secret de signature du Pulse : Automatisations → Pulses → votre Pulse → Overview → Signing secret (whsec_…).
# CHARIOW_PULSE_SECRET=
# Pendant une rotation de secret, l'ancien reste accepté tant qu'il est déclaré ici (à retirer ensuite).
# CHARIOW_PULSE_SECRET_PREVIOUS=
# Identifiant de la boutique (str_…) : une vente d'une autre boutique part en revue.
# CHARIOW_STORE_ID=
# Les neuf produits (type « Licence » : achats répétés autorisés), identifiants réels de la boutique :
# CHARIOW_PRODUCTS={"essential_monthly":"prd_…","essential_yearly":"prd_…","plus_monthly":"prd_…","plus_yearly":"prd_…","pro_monthly":"prd_…","pro_yearly":"prd_…","topup_70":"prd_…","topup_180":"prd_…","topup_500":"prd_…"}
# Domaines autorisés pour l'adresse de paiement renvoyée par Chariow (séparés par des virgules).
# CHARIOW_CHECKOUT_HOSTS=chariow.com,mychariow.com,chariow.shop,moneroo.io
# Adresse publique du site (retour de paiement, liens email).
# LIMPID_SITE_URL=https://limpid.company

# Connexion Google / Apple (Supabase Auth > Providers). Mettre "on" seulement une fois le
# fournisseur réglé dans Supabase : sinon aucun bouton n'est affiché.
LIMPID_AUTH_GOOGLE=
LIMPID_AUTH_APPLE=

# Coupe-circuits de secours (signalés dans les journaux quand ils sont actifs) :
# LIMPID_SESSION_POLICY=off  → plus de contrôle des sessions d'appareil (7 j / 90 j)
# LIMPID_ADMIN_MFA=off       → plus de double authentification pour /admin

# Couvertures de leçons générées (modèle image Gemini, LIMPID_IMAGE_MODEL) : "off" pour les couper.
LIMPID_COVERS_GEMINI=on
