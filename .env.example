# Copier en .env.local pour le développement. Ne jamais committer de vraie valeur.

# Fournisseur IA (cadrage Q3). Sans clé : mode démonstration explicite.
LIMPID_AI_PROVIDER=gemini
GEMINI_API_KEY=
# Essai réel du 4 octobre 2026 : gemini-3.5-flash valide le pipeline ; les modèles Pro sont à quota nul sur la clé actuelle (offre gratuite probable).
# Offre gratuite : 20 requêtes par jour ET par modèle (constaté le 4 octobre 2026). Un rapport coûte 2 à 6 requêtes,
# une lecture OCR 1 par lot de 8 pages, une correction de quiz 1. Deux modèles différents = deux quotas séparés.
LIMPID_MODEL_FAST=gemini-3.5-flash
LIMPID_MODEL_QUALITY=gemini-3.5-flash

# Supabase (cadrage Q2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Alpha privée : emails autorisés, séparés par des virgules (cadrage Q7)
LIMPID_ALLOWED_EMAILS=

# Limites (payload 1, § 2)
LIMPID_MAX_FILE_MB=20
LIMPID_MAX_PAGES=100
# Texte retenu d'un fichier ou d'une page web ; au-delà, couverture partielle signalée.
LIMPID_MAX_SOURCE_CHARS=300000
LIMPID_MAX_IMAGE_MP=20
LIMPID_MAX_PASTED_CHARS=50000

# Vérification indépendante des affirmations contre leurs extraits (1 appel rapide par rapport).
LIMPID_VERIFY_CLAIMS=on

# Limites anti-abus par compte (cahier V2, § 13)
LIMPID_DAILY_REPORTS=3
LIMPID_ACTIVE_JOBS_PER_ACCOUNT=1

# Budget en centimes d'euro (cadrage Q17)
LIMPID_MONTHLY_CAP_CENTS=1000
LIMPID_REPORT_CAP_CENTS=50
LIMPID_ACCOUNT_DAILY_CAP_CENTS=200

# Conservation (cadrage Q18) : 0 = rapports gardés jusqu'à suppression manuelle
LIMPID_RETENTION_ORIGINAL_HOURS=24
LIMPID_RETENTION_REPORT_DAYS=0

# Phase 2b
# URL publique utilisée dans les liens magiques (sinon déduite de la requête).
LIMPID_SITE_URL=
# Secret du cron Vercel qui reprend les tâches en attente (/api/worker).
CRON_SECRET=
# Tarifs d'estimation en centimes d'euro par million de jetons (à confirmer sur la grille Gemini).
LIMPID_PRICE_INPUT_CENTS_PER_MTOK=50
LIMPID_PRICE_OUTPUT_CENTS_PER_MTOK=400

# Quota gratuit Gemini affiché dans l'administration (requêtes par jour et par modèle).
LIMPID_FREE_TIER_RPD=20

# Lecture OCR des images et PDF scannés (vision Gemini), avec accord de l'utilisateur.
LIMPID_MAX_OCR_PAGES=30
LIMPID_MAX_OCR_MB=14

# Phase 3
# Import par lien (protection SSRF intégrée). « off » pour le désactiver.
LIMPID_URL_IMPORT=on

# Lot D — illustrations (cahier V2, § 9-10). Aucune dépendance payante n'est activée par défaut.
# Wikimedia Commons (gratuit, licences libres vérifiées fichier par fichier). « off » pour le couper.
LIMPID_ILLUSTRATIONS_COMMONS=on
# Unsplash : clé d'API requise ; images affichées sur le web seulement (jamais dans le PDF).
UNSPLASH_ACCESS_KEY=
LIMPID_ILLUSTRATIONS_UNSPLASH=off
# Gemini Image : modèle image séparé du modèle texte (ex. gemini-3.1-flash-lite-image), compte payant.
LIMPID_IMAGE_MODEL=
LIMPID_ILLUSTRATIONS_GEMINI=off
LIMPID_GENERATED_IMAGES_PER_MONTH=20
